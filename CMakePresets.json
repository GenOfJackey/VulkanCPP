{
        "version": 8,
        "configurePresets": [
                {
                        "name": "vulkanCPP-Debug",
                        "displayName": "GCC Linux DEBUG",
                        "description": "Using compilers: C = /usr/bin/gcc, CXX = /usr/bin/g++",
                        "binaryDir": "${sourceDir}/out/build/${presetName}",
                        "cacheVariables": {
                                "CMAKE_RUNTIME_OUTPUT_DIRECTORY": "${sourceDir}/dist/debug",
                                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                                "CMAKE_C_COMPILER": "/usr/bin/gcc",
                                "CMAKE_CXX_COMPILER": "/usr/bin/g++",
                                "CMAKE_BUILD_TYPE": "Debug"
                        }
                },
                {
                        "name": "vulkanCPP-Release",
                        "displayName": "GCC Linux RELEASE",
                        "description": "Using compilers: C = /usr/bin/gcc, CXX = /usr/bin/g++",
                        "binaryDir": "${sourceDir}/out/build/${presetName}",
                        "cacheVariables": {
                                "CMAKE_RUNTIME_OUTPUT_DIRECTORY": "${sourceDir}/dist/release",
                                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                                "CMAKE_C_COMPILER": "/usr/bin/gcc",
                                "CMAKE_CXX_COMPILER": "/usr/bin/g++",
                                "CMAKE_BUILD_TYPE": "Release"
                        }
                }
        ]
}